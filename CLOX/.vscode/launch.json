{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug clox",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/clox",
      "args": [],
    //   "args": ["${file}"] // For Debugging a specific file.
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "make build",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}